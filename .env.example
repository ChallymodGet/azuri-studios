# Free scheduling (pick one):
# - Calendly: https://calendly.com (free tier)
# - Cal.com: https://cal.com (free tier)
# - Google Calendar → Create → Appointment schedule → copy booking page link
#
# Copy to `.env.local` for local dev. Add the same variable in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/azuristudio-co/30min

# Sanity CMS (free tier: https://www.sanity.io)
# Create a project, then add these in Vercel + .env.local. Without them, the site uses built-in fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
